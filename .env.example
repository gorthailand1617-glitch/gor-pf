# GPF-SmartInvestor-AI Environment Variables

# Server Config
PORT=8000
HOST=0.0.0.0

# Gemini API Key (Required for sentiment & commentary)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# Share the Google Sheet with the client_email in service_account.json
SPREADSHEET_ID=your_google_sheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# LINE Messaging API (Optional - logs warning and runs without alerts if missing)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# Used to verify or test push messages
LINE_USER_ID=your_test_line_user_id_here

# Telegram Bot API (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

