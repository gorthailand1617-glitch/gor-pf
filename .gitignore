# 1. Sensitive Credentials & Secrets (CRITICAL)
.env
.env.*
!.env.example
service_account*.json
*.pem
*.key
*.cert

# 2. Python Virtual Environments & Caches
.venv/
venv/
ENV/
env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# 3. Next.js & Frontend Build Outputs
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
build/
*/build/
.pnp
.pnp.js
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Local Databases & Logs
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
*.log

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
